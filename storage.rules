rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 教學歷程檔案附件（課程表、學員名單、講義）：僅管理員本人可讀寫
    match /teaching_files/{fileName} {
      allow read, write: if request.auth != null && request.auth.token.email == "jiahowchang@gmail.com";
    }
    // 其他路徑預設禁止存取
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
